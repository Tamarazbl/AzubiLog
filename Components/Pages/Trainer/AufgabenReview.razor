@page "/ausbilder/aufgaben"
@attribute [Authorize(Roles = "Ausbilder")]
@inject AzubiLog.Services.Trainer.ITrainerService TrainerService
@rendermode InteractiveServer

<PageTitle>Aufgaben prüfen – AzubiLog</PageTitle>

<div class="page-header">
    <h1>Aufgaben prüfen</h1>
    <p class="subtitle">Überprüfe die erledigten Aufgaben deiner Azubis</p>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (todos.Count == 0)
{
    <div class="card">
        <p class="text-muted">Keine erledigten Aufgaben von deinen Azubis vorhanden.</p>
    </div>
}
else
{
    <div class="card">
        <h3>Filter</h3>
        <div class="inline-form">
            <select @bind="filterStatus">
                <option value="">Alle</option>
                <option value="Offen">Noch nicht geprüft</option>
                <option value="Genehmigt">Genehmigt</option>
                <option value="Abgelehnt">Abgelehnt</option>
            </select>
        </div>
    </div>

    @foreach (var group in filteredTodos.GroupBy(t => t.User.FirstName + " " + t.User.LastName))
    {
        <div class="card mt-3">
            <h3>@group.Key</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Aufgabe</th>
                        <th>Beschreibung</th>
                        <th>Erstellt</th>
                        <th>Status</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var todo in group)
                    {
                        <tr>
                            <td><strong>@todo.Title</strong></td>
                            <td class="text-muted">@(todo.Description ?? "–")</td>
                            <td>@todo.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge badge-@todo.ReviewStatus.ToLower()">@todo.ReviewStatus</span>
                                @if (!string.IsNullOrEmpty(todo.ReviewComment))
                                {
                                    <br /><small class="text-muted">@todo.ReviewComment</small>
                                }
                            </td>
                            <td>
                                @if (todo.ReviewStatus == "Offen")
                                {
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-primary" @onclick="() => ApproveTodo(todo.Id)">In Ordnung</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => StartReject(todo.Id)">Ablehnen</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="() => ResetTodo(todo.Id)">Zurücksetzen</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (rejectingTodoId.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:999">
        <div class="card" style="max-width:480px;width:100%">
            <h3>Aufgabe ablehnen</h3>
            <p class="text-muted">Bitte gib einen Grund an, warum die Aufgabe nicht in Ordnung ist.</p>
            <div class="form-group">
                <label>Begründung *</label>
                <textarea @bind="rejectComment" rows="3" placeholder="z.B. Aufgabe nicht vollständig erledigt..."></textarea>
            </div>
            <div class="btn-group mt-2">
                <button class="btn btn-danger" @onclick="ConfirmReject" disabled="@string.IsNullOrWhiteSpace(rejectComment)">Ablehnen</button>
                <button class="btn btn-outline" @onclick="CancelReject">Abbrechen</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TodoItem> todos = new();
    private string filterStatus = "";
    private string? successMessage;
    private string? errorMessage;
    private int? rejectingTodoId;
    private string rejectComment = "";

    private IEnumerable<TodoItem> filteredTodos =>
        string.IsNullOrEmpty(filterStatus)
            ? todos
            : todos.Where(t => t.ReviewStatus == filterStatus);

    protected override async Task OnInitializedAsync()
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        todos = await TrainerService.GetAllApprenticeTodosAsync();
    }

    private async Task ApproveTodo(int id)
    {
        errorMessage = null;
        try
        {
            await TrainerService.ReviewTodoAsync(id, "Genehmigt", null);
            successMessage = "Aufgabe als in Ordnung markiert.";
            await LoadTodos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void StartReject(int id)
    {
        rejectingTodoId = id;
        rejectComment = "";
    }

    private void CancelReject()
    {
        rejectingTodoId = null;
        rejectComment = "";
    }

    private async Task ConfirmReject()
    {
        if (!rejectingTodoId.HasValue || string.IsNullOrWhiteSpace(rejectComment)) return;
        errorMessage = null;
        try
        {
            await TrainerService.ReviewTodoAsync(rejectingTodoId.Value, "Abgelehnt", rejectComment.Trim());
            successMessage = "Aufgabe abgelehnt mit Begründung.";
            rejectingTodoId = null;
            rejectComment = "";
            await LoadTodos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ResetTodo(int id)
    {
        errorMessage = null;
        try
        {
            await TrainerService.ReviewTodoAsync(id, "Offen", null);
            successMessage = "Status zurückgesetzt.";
            await LoadTodos();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
