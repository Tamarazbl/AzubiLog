<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AzubiLog.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <script>
        // Apply saved theme immediately to prevent flash
        (function() {
            var theme = localStorage.getItem('azubilog-theme') || 'light';
            var el = document.getElementById('app-shell');
            if (el) {
                el.className = 'app-shell theme-' + theme;
            }
        })();
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.azubiToggleTheme = function() {
            var el = document.getElementById('app-shell');
            if (!el) return;
            var isDark = el.classList.contains('theme-dark');
            el.classList.remove('theme-dark', 'theme-light');
            el.classList.add(isDark ? 'theme-light' : 'theme-dark');
            localStorage.setItem('azubilog-theme', isDark ? 'light' : 'dark');
        };
        // Apply on page load (after Blazor renders)
        document.addEventListener('DOMContentLoaded', function() {
            var theme = localStorage.getItem('azubilog-theme') || 'light';
            var el = document.getElementById('app-shell');
            if (el) {
                el.classList.remove('theme-dark', 'theme-light');
                el.classList.add('theme-' + theme);
            }
        });
        // Also apply after Blazor enhanced navigation
        if (typeof Blazor !== 'undefined') {
            Blazor.addEventListener('enhancedload', function() {
                var theme = localStorage.getItem('azubilog-theme') || 'light';
                var el = document.getElementById('app-shell');
                if (el) {
                    el.classList.remove('theme-dark', 'theme-light');
                    el.classList.add('theme-' + theme);
                }
            });
        }
    </script>
</body>

</html>
